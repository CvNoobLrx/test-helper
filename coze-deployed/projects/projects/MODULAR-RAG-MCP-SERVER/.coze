[project]
sub_id = "cd30db57"
name = "modular-rag-mcp-server"
requires = ["python-3.12", "nodejs-24"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/setup.sh"]
run = ["bash", "scripts/http_run.sh", "-p", "5000"]

[deploy]
build = ["bash", "scripts/setup.sh"]
run = ["bash", "scripts/http_run.sh", "-p", "5000"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy.backend]
enabled = true
